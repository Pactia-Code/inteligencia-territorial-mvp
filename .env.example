# =============================================================================
# Plantilla de configuracion — Inteligencia Territorial MVP
#
# COPIA este archivo como  .env  y rellena los valores reales ahi.
#   El archivo  .env  NUNCA se sube a git (ya esta en .gitignore).
#   Este  .env.example  SI se sube, pero solo con valores de ejemplo.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM — Azure OpenAI (tenant de Pactia)
# -----------------------------------------------------------------------------
# AQUI VA LA API KEY. Se obtiene en el portal de Azure AI Foundry,
# en el recurso donde estan desplegados los modelos, seccion "Keys and Endpoint".
AZURE_OPENAI_API_KEY=pega-aqui-la-clave

# Endpoint COMPLETO, con https:// y sin barra final.
# A diferencia del cliente de Claude, aqui va la URL entera, no solo el nombre.
AZURE_OPENAI_ENDPOINT=https://nombre-del-recurso.openai.azure.com

# Version de la API. Aparece en el portal, en la vista del despliegue.
AZURE_OPENAI_API_VERSION=2024-10-21

# NOMBRES DE DESPLIEGUE, no nombres de modelo.
# En Azure cada despliegue lleva el nombre que le pusiste al crearlo, que puede
# no coincidir con el del modelo. Copia el de la columna "Deployment name".
MODELO_CLASIFICADOR=gpt-4o-mini
MODELO_CORRELACIONADOR=gpt-4o
MODELO_SINTETIZADOR=gpt-4o

# -----------------------------------------------------------------------------
# Observabilidad — Langfuse
# -----------------------------------------------------------------------------
# Se obtienen en https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# -----------------------------------------------------------------------------
# Almacenamiento — local por defecto (D8)
# -----------------------------------------------------------------------------
# "local" usa carpetas y SQLite. "azure" usa Blob Storage y PostgreSQL.
MODO_ALMACEN=local

# --- Modo local ---
RUTA_BLOB_LOCAL=data/blob
URL_BASE_DATOS=sqlite:///data/territorial.db

# --- Modo azure (dejar vacio mientras se trabaje en local) ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTENEDOR=territorial
# URL_BASE_DATOS en azure tendria la forma:
#   postgresql+psycopg://usuario:clave@servidor.postgres.database.azure.com:5432/territorial

# -----------------------------------------------------------------------------
# Parametros del experimento (Addendum 01)
# -----------------------------------------------------------------------------
RUTA_SNAPSHOT=docs/territorial_data_cruda_v3.json
CICLO_CORTE_1=2025-10-22
CICLO_CORTE_2=2026-01-14
VENTANA_INICIO=2025-09-01
VENTANA_FIN=2026-09-09

# Umbral de cobertura: por debajo de esto los factores SECOP se marcan sin_cobertura
UMBRAL_COBERTURA=0.30
